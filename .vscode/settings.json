{
  "cmake.generator": "Ninja",

  "cmake.configureSettings": {
    "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
  },

  "cmake.configureArgs": [
    "-DCMAKE_TOOLCHAIN_FILE=${workspaceFolder}/.vcpkg/scripts/buildsystems/vcpkg.cmake",
    "-DVCPKG_MANIFEST_DIR=${workspaceFolder}/cmake/vcpkg",
    "-DVCPKG_TARGET_TRIPLET=x64-windows-static"
  ],

  "cmake.buildDirectory": "${workspaceFolder}/_cmake_debug",

  "C_Cpp.default.compileCommands": "${workspaceFolder}/_cmake_debug/compile_commands.json",
  "C_Cpp.default.intelliSenseMode": "windows-msvc-x64",
  "C_Cpp.default.compilerPath": "cl.exe"
}